import io.github.baole.konture.architecture
import org.junit.jupiter.api.Test

class ArchitectureGuardrails {

    // Foundational Pillar 1 — Dependency Direction & Layer Isolation
    @Test
    fun `domain layer should be completely isolated from data and UI layers`() {
        architecture {
            // Use wildcard/pattern matching for scalable rule enforcement
            modules {
                that().haveNameMatching(":core:domain**")
                should().notDependOnModule(":core:data**")
                andShould().notDependOnModule(":feature:**")
            }
        }
    }

